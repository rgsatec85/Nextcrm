# Local dev (docker-compose): usa o role app_user, sujeito a RLS.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/crm_enterprise?schema=public"

# Usado apenas pelo TenantsService para provisionar novos tenants (signup),
# nunca em queries request-scoped comuns. Em produção (Supabase), aponte
# para o role app_service criado na migration, com BYPASSRLS.
DATABASE_SERVICE_URL="postgresql://app_service:app_service@localhost:5432/crm_enterprise?schema=public"

PORT=3001
NODE_ENV=development

JWT_SECRET="change-me-in-production-use-a-long-random-value"
JWT_EXPIRES_IN="8h"

CORS_ORIGIN="http://localhost:3000"

# Opcional (Fase 5 — Hardening/Escala). Se ausente, o rate limiting cai
# automaticamente para armazenamento em memória (por instância) e
# GET /api/health/ready reporta Redis como "not_configured" em vez de
# "error" — nenhum dos dois quebra o backend. Em produção no Render, deixe
# sem definir até provisionar um Redis de verdade (ex.: Upstash) — ver
# docs/scaling-checklist.md. O docker-compose de desenvolvimento
# (infrastructure/docker-compose.yml) já sobe um Redis local nesta mesma
# URL, então localmente isso normalmente já funciona sem mudar nada.
REDIS_URL="redis://localhost:6379"

# Opcional (Fase 5 — Observabilidade). Sem isso definido, o OpenTelemetry
# SDK não inicia (zero custo, zero risco) — ver docs/observability.md para
# como apontar isso para o stack local
# (infrastructure/docker-compose.observability.yml) ou para um provedor
# gerenciado (Grafana Cloud) em produção.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="crm-backend"

# Fase 4 — Inteligência Artificial Corporativa. "deterministic" (default) não
# precisa de nenhuma configuração extra e é o único caminho testado neste
# sandbox. "ollama" ativa o AiProvider real (fetch para um servidor Ollama
# self-hosted) — se ele falhar por qualquer motivo, o backend cai de volta
# para o determinístico automaticamente (ver OllamaAiProvider).
AI_PROVIDER="deterministic"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
